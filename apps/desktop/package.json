{
  "name": "vibe-logisim-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Native desktop shell for the Vibe Logisim Circuit Lens",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test:e2e": "node test/e2e-workspace.cjs",
    "vendor:ui": "node ../../scripts/ui/vendor.cjs",
    "postinstall": "npm run vendor:ui",
    "package:linux": "python3 ../../scripts/distribution/build.py",
    "test:packaged": "node test/e2e-packaged.cjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "playwright": "1.62.1"
  },
  "dependencies": {
    "dompurify": "3.4.15",
    "lucide": "1.46.0",
    "marked": "18.0.13",
    "pdfjs-dist": "6.3.289"
  }
}
