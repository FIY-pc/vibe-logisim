[Unit]
Description=Vibe Logisim Classroom
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/vibe-logisim-classroom/current
EnvironmentFile=/home/ubuntu/apps/vibe-logisim-classroom/classroom.env
ExecStart=/home/ubuntu/apps/vibe-logisim-classroom/runtime/bin/node /home/ubuntu/apps/vibe-logisim-classroom/current/classroom-server.mjs
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/apps/vibe-logisim-classroom/data
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
