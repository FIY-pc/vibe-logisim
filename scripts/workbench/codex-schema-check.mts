  const byMethod = (union: any) =>
    new Map<string, any>(
      union.oneOf.map((variant: any) => [
        variant.properties.method.enum[0],
        variant,
      ]),
    );
  const requestVariants = byMethod(requests);
  const notificationVariants = byMethod(notifications);
  const checkRequest = validator(requests);
  const checkNotification = validator(notifications);
  const checkToolResponse = validator(toolResponse);
  const validate = (log: string) => {
    const messages = traffic(log);
    const serverRequests = new Map(
      messages
        .filter((t) => t.direction === "server" && t.message.method)
        .map((t) => [t.message.id, t.message.method]),
    );
    const errors: string[] = [];
    let count = 0;
    for (const { direction, message } of messages) {
      if (direction !== "client") continue;
      count += 1;
      if (message.method !== undefined) {
        const request = message.id !== undefined;
        const variant = (request ? requestVariants : notificationVariants).get(
          message.method,
        );
        if (!variant) errors.push(`${message.method}: not in the protocol`);
        else
          errors.push(
            ...(request ? checkRequest : checkNotification)(
              variant,
              message,
              message.method,
            ),
          );
      } else if (serverRequests.get(message.id) === "item/tool/call") {
        if (message.error) errors.push(`${message.id}: JSON-RPC error reply`);
        else
          errors.push(
            ...checkToolResponse(toolResponse, message.result, message.id),
          );
      } else count -= 1;
    }
    return { errors, count };
  };
  let validated = 0;
  const expectValid = (log: string, label: string) => {
    const { errors, count } = validate(log);
    assert.deepEqual(
      errors,
      [],
      `${label}: ${errors.length} schema errors\n${errors.slice(0, 20).join("\n")}`,
    );
    validated += count;
  };

  // The validator must reject exactly the two shapes 0.154 refuses.
