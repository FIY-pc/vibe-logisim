        finish: async () => null,
        finishEvent: () => null,
        abort: async () => undefined,
      },
    });
    const events: any[] = [];
    backend.on("event", (event: any) => events.push(event));
    const observation = {
      id: "moment-1",
      documentId: "document-a",
      documentName: "main.circ",
      revision: "revision-a",
      circuit: "main",
      rootCircuit: "main",
      instancePath: [],
      viewId: "view-1",
      createdAt: "2026-01-01T00:00:00.000Z",
      title: "Output high",
      signals: [{ key: "c10_20:2", label: "G1", bits: "1" }],
      trace: null,
      historical: true,
    };
    const references: StoredReference[] = [
      {
        id: "material-1",
        kind: "material",
        label: "notes.txt",
        path: "notes.txt",
        revision: "r1",
        hasImage: false,
        workspaceKey: "document-a",
        text: "An AND gate outputs 1 only when both inputs are 1.",
      },
      {
        id: "observation-1",
        kind: "observation",
        label: "Output high",
        revision: "revision-a",
        hasImage: true,
        workspaceKey: "document-a",
        text: JSON.stringify(observation),
        image: "data:image/png;base64," + PNG,
      },
    ];
    const context = {
      folder: { path: folder, activeFile: "main.circ" },
      workspaceKey: "document-a",
      folderId: "folder-1",
      projectId: "document-a",
      revisionId: "revision-a",
      circuit: "main",
      ...selectionContext({
        graph,
        circuit: "main",
        projectId: "document-a",
        revisionId: "revision-a",
        ids: ["c10_20", "w1"],
        visibleTools: visible,
      }),
      references,
    };
    try {
      await backend.start();
      const turn = (await backend.ask({
        question: "Tidy this gate.",
        workspaceKey: "document-a",
        context,
      })) as { turnId: string };
      await until(
        () => Object.keys(toolResults(log)).length === calls.length,
        "plugin tool responses",
      );
      await backend.ask({
        question: "Keep the output on the right.",
        workspaceKey: "document-a",
        expectedTurnId: turn.turnId,
        context: { ...context, references: [] },
      });
      await backend.interrupt();
      await until(
        () => events.some((event) => event.type === "turn-completed"),
        "the interrupted plugin turn",
      );
    } finally {
      await backend.stop();
    }
    expectValid(log, "plugin");
    const [thread] = sent(log, "thread/start");
    assert.deepEqual(
      thread.dynamicTools.map((tool: any) => tool.name).sort(),
      [...visible].sort(),
    );
    assert.equal(visible.size, 12, "the P0 catalog is closed");
    assert.ok(
      backend.referencePath &&
        thread.developerInstructions.includes(backend.referencePath) &&
        !thread.developerInstructions.includes("{{REFERENCE_PATH}}"),
      "developer instructions name the mounted reference directory",
    );
    const [start] = sent(log, "turn/start");
    const entries = start.additionalContext;
    assert.deepEqual(
      Object.fromEntries(
        Object.entries(entries).map(([key, entry]: [string, any]) => [
          key,
          entry.kind,
        ]),
      ),
      {
        "vibe-logisim.binding": "application",
        "vibe-logisim.evidence": "untrusted",
        "vibe-logisim.kept-observation-1": "untrusted",
        "vibe-logisim.materials": "application",
        "vibe-logisim.material-1": "untrusted",
        "vibe-logisim.workspace": "application",
        "vibe-logisim.workspace-index": "untrusted",
      },
    );
    const workspace = JSON.parse(entries["vibe-logisim.workspace"].value);
    assert.equal(workspace.cwd, backend.runtimeWorkDir);
    assert.equal(workspace.changeMode, "direct");
    assert.equal(workspace.currentSource.alignment, "aligned");
    const binding = JSON.parse(entries["vibe-logisim.binding"].value);
    assert.equal(binding.plugin.version, MANIFEST.version);
    assert.deepEqual(binding.keptObservationRefs, [
      { id: "observation-1", title: "Output high", revisionId: "revision-a" },
    ]);
    assert.equal(start.input[1].type, "image");
    assert.ok(
      sent(log, "turn/steer")[0].additionalContext["vibe-logisim.binding"],
    );
    const results = toolResults(log);
    const result = (index: number) => results["tool-" + index];
    assert.deepEqual(
      calls.map((_, index) => result(index).success),
      [true, true, true, true, true, false, false, false, false, false],
    );
    const opened = parsed(result(0));
    assert.equal(opened.schema, "vibe-logisim.circuit-action/v1");
    assert.deepEqual(opened.canvas, { status: "shown", circuit: "main" });
    assert.equal(parsed(result(1)).nativeLoadability.status, "loadable");
    assert.match(
      result(2).contentItems[1].imageUrl,
      /^data:image\/png;base64,/,
    );
    assert.deepEqual(parsed(result(3)).changes, [
      { circuit: "main", difference: { moved: 2 } },
    ]);
    assert.deepEqual(
      events.find((event) => event.type === "candidate-ready"),
      {
        type: "candidate-ready",
        turnId: "turn-1",
        candidateId: "candidate-1",
        title: "Arranged main",
      },
    );
    assert.equal(parsed(result(4)).candidateId, "candidate-1");
    const failure = (index: number) => parsed(result(index)).error;
    assert.equal(failure(5).code, "CIRCUIT_NOT_FOUND");
    assert.equal(failure(5).schema, ERROR_SCHEMA);
    assert.equal(failure(5).context.invocation.callId, "call-5");
    assert.equal(failure(5).context.invocation.revisionId, "revision-a");
    assert.deepEqual(
      [failure(6).code, failure(6).retryable, failure(6).hint],
      ["STALE_REVISION", true, "重新读取电路后再验证。"],
    );
    assert.equal(failure(7).code, "TOOL_FAILED");
    assert.equal(failure(8).code, "INVALID_ARGUMENT");
    assert.equal(failure(9).code, "CIRCUIT_TOOL_FAILED");
    assert.equal(
      existsSync(path.join(directory, "plugin-profile/auth.json")),
      false,
    );
  }
  console.log(
    `Verified ${validated} client messages, including every dynamic tool response, against the app-server schema of the locked runtime: the sidecar and the circuit plugin send typed dynamic tools and context entries.`,
  );
} finally {
  await rm(directory, { recursive: true, force: true });
}
