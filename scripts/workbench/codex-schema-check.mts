type Schema = boolean | Record<string, any>;
const KEYWORDS = new Set([
  "$schema",
  "$ref",
  "title",
  "description",
  "default",
  "definitions",
  "type",
  "enum",
  "format",
  "minimum",
  "minLength",
  "properties",
  "required",
  "additionalProperties",
  "items",
  "anyOf",
  "oneOf",
  "allOf",
]);
// Draft-07 subset used by the generated protocol. An unknown keyword stops the
// check instead of passing silently.
function validator(document: Record<string, any>) {
  const kind = (value: unknown) =>
    value === null ? "null" : Array.isArray(value) ? "array" : typeof value;
  const is = (value: unknown, type: string) =>
    type === "integer"
      ? Number.isInteger(value)
      : type === "number"
        ? typeof value === "number"
        : kind(value) === type;
  const check = (schema: Schema, value: any, at: string): string[] => {
    if (schema === true) return [];
    if (schema === false) return [`${at}: not allowed`];
    for (const key of Object.keys(schema))
      if (!KEYWORDS.has(key))
        throw new Error(`Unsupported schema keyword ${key} at ${at}`);
    if (schema.$ref) {
      const name = /^#\/definitions\/(.+)$/.exec(schema.$ref)?.[1];
      const target = name && document.definitions?.[name];
      if (target === undefined) throw new Error("Unresolved " + schema.$ref);
      return check(target, value, at);
    }
    if (schema.type !== undefined) {
      const types: string[] = [schema.type].flat();
      if (!types.some((type) => is(value, type)))
        return [`${at}: expected ${types.join("|")}, got ${kind(value)}`];
    }
    const errors: string[] = [];
    if (
      schema.enum &&
      !schema.enum.some((option: unknown) => isDeepStrictEqual(option, value))
    )
      errors.push(`${at}: ${JSON.stringify(value)} not in enum`);
    if (schema.format !== undefined && typeof value === "number") {
      if (/^u?int(8|16|32|64)?$/.test(schema.format)) {
        if (
          !Number.isInteger(value) ||
          (schema.format.startsWith("u") && value < 0)
        )
          errors.push(`${at}: not ${schema.format}`);
      } else if (schema.format !== "double")
        throw new Error(`Unsupported format ${schema.format} at ${at}`);
    }
    if (schema.minimum !== undefined && value < schema.minimum)
      errors.push(`${at}: below ${schema.minimum}`);
    if (schema.minLength !== undefined && [...value].length < schema.minLength)
      errors.push(`${at}: shorter than ${schema.minLength}`);
    if (kind(value) === "object") {
      for (const name of schema.required || [])
        if (!Object.hasOwn(value, name))
          errors.push(`${at}: missing required ${name}`);
      for (const [name, item] of Object.entries(value)) {
        if (schema.properties && Object.hasOwn(schema.properties, name))
          errors.push(...check(schema.properties[name], item, `${at}.${name}`));
        else if (schema.additionalProperties !== undefined)
          errors.push(
            ...check(schema.additionalProperties, item, `${at}.${name}`),
          );
      }
    }
    if (Array.isArray(value) && schema.items !== undefined)
      value.forEach((item, index) =>
        errors.push(...check(schema.items, item, `${at}[${index}]`)),
      );
    for (const branch of schema.allOf || [])
      errors.push(...check(branch, value, at));
    for (const keyword of ["anyOf", "oneOf"]) {
      if (!schema[keyword]) continue;
      const results: string[][] = schema[keyword].map((branch: Schema) =>
        check(branch, value, at),
      );
      const passing = results.filter((result) => !result.length).length;
      if (!passing) {
        const closest = results.reduce((a, b) => (b.length < a.length ? b : a));
        errors.push(`${at}: no ${keyword} branch (closest: ${closest[0]})`);
      } else if (keyword === "oneOf" && passing > 1)
        errors.push(`${at}: ${passing} oneOf branches match`);
    }
    return errors;
  };
  return check;
}

interface Traffic {
  direction: "client" | "server";
  message: Record<string, any>;
}
// The scripted peer answers the startup, thread and turn requests, sends the
// given dynamic tool calls once the turn exists, and completes an interrupted
// turn. Every message in both directions is appended to `log`.
function fakeAppServer(log: string, calls: [string, unknown][]) {
  return `
import { createRequire, syncBuiltinESMExports } from "node:module";
import { EventEmitter } from "node:events";
import { PassThrough } from "node:stream";
import { appendFileSync } from "node:fs";
import { createInterface } from "node:readline";
const record = (direction, message) =>
  appendFileSync(${JSON.stringify(log)}, JSON.stringify({ direction, message }) + "\\n");
const calls = ${JSON.stringify(calls)};
const answers = {
  initialize: () => ({}),
  "account/read": () => ({ account: null, requiresOpenaiAuth: false }),
  "config/read": () => ({ config: {} }),
  "model/list": () => ({ data: [] }),
  "thread/start": () => ({ thread: { id: "thread-1", turns: [] } }),
  "mcpServerStatus/list": () => ({ data: [] }),
  "turn/start": () => ({ turn: { id: "turn-1", status: "inProgress", items: [] } }),
  "turn/steer": (params) => ({ turnId: params.expectedTurnId }),
  "turn/interrupt": () => ({}),
};
function peer() {
  const child = new EventEmitter();
  Object.assign(child, { stdin: new PassThrough(), stdout: new PassThrough(), stderr: new PassThrough(), pid: undefined, exitCode: null, signalCode: null });
  const exit = () => {
    if (child.exitCode !== null) return;
    child.exitCode = 0;
    child.stdout.end();
    child.stderr.end();
    setImmediate(() => child.emit("exit", 0, null));
  };
  child.kill = () => (exit(), true);
  child.stdin.on("finish", exit);
  const write = (message) => {
    record("server", message);
    child.stdout.write(JSON.stringify(message) + "\\n");
  };
  createInterface({ input: child.stdin }).on("line", (line) => {
    const message = JSON.parse(line);
    record("client", message);
    if (message.method === undefined || message.id === undefined) return;
    const answer = answers[message.method];
    write(answer
      ? { id: message.id, result: answer(message.params) }
      : { id: message.id, error: { code: -32601, message: "no fixture for " + message.method } });
    const { threadId, turnId } = message.params;
    if (message.method === "turn/start")
      setTimeout(() => calls.forEach(([tool, args], index) => write({
        id: "tool-" + index,
        method: "item/tool/call",
        params: { threadId, turnId: "turn-1", callId: "call-" + index, namespace: null, tool, arguments: args },
      })), 20);
    if (message.method === "turn/interrupt")
      setTimeout(() => write({ method: "turn/completed", params: { threadId, turn: { id: turnId, status: "interrupted", items: [], error: null } } }), 20);
  });
  return child;
}
const childProcess = createRequire(import.meta.url)("node:child_process");
const original = childProcess.spawn;
childProcess.spawn = (command, args = [], options) => {
  if (args.includes("app-server")) return peer();
  // Stopping the transient unit of a peer that never ran.
  if (args[0] === "--user" && args[1] === "stop") {
    const child = new EventEmitter();
    child.kill = () => true;
    setImmediate(() => child.emit("exit", 0, null));
    return child;
  }
  return original(command, args, options);
};
syncBuiltinESMExports();
`;
}
const traffic = (log: string): Traffic[] =>
  existsSync(log)
    ? readFileSync(log, "utf8")
        .split("\n")
        .filter(Boolean)
        .map((line) => JSON.parse(line))
    : [];
const toolResults = (log: string) =>
  Object.fromEntries(
    traffic(log)
      .filter(
        ({ direction, message }) =>
          direction === "client" &&
          message.method === undefined &&
          String(message.id).startsWith("tool-"),
      )
      .map(({ message }) => [message.id, message.result]),
  );
const sent = (log: string, method: string) =>
  traffic(log)
    .filter((t) => t.direction === "client" && t.message.method === method)
    .map((t) => t.message.params);
async function until(condition: () => boolean, what: string) {
  for (const start = Date.now(); !condition();) {
    if (Date.now() - start > 20_000)
      throw new Error("Timed out waiting for " + what);
    await new Promise((resolve) => setTimeout(resolve, 20));
  }
}
const parsed = (result: any) => JSON.parse(result.contentItems[0].text);

const directory = await mkdtemp(path.join(tmpdir(), "vibe-codex-schema-"));
try {
  const home = path.join(directory, "home");
