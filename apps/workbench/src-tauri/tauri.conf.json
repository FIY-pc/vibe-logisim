{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibe Logisim",
  "version": "0.6.0-beta.3",
  "identifier": "dev.vibelogisim.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vibe Logisim",
        "create": false,
        "dragDropEnabled": true,
        "width": 1440,
        "height": 940,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; worker-src 'self' blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
